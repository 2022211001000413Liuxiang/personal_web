---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categories = [...new Set(posts.map((post) => post.data.category))];
const allTags = [...new Set(posts.flatMap((post) => post.data.tags))];
---

<BaseLayout title="博客 | 技术博客" description="浏览所有技术文章">
  <div class="max-w-6xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold mb-8">博客文章</h1>

    <div class="flex flex-col lg:flex-row gap-8">
      <!-- Sidebar -->
      <aside class="lg:w-64 flex-shrink-0">
        <!-- Categories -->
        <div class="mb-8">
          <h3 class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-3">分类</h3>
          <ul class="space-y-2">
            <li>
              <a href="/blog" class="block w-full text-left px-3 py-2 rounded-lg text-sm bg-primary-100 text-primary-700 dark:bg-primary-900/50 dark:text-primary-300">
                全部
              </a>
            </li>
            {categories.map((cat) => (
              <li>
                <a href={`/blog/category/${cat}`} class="block w-full text-left px-3 py-2 rounded-lg text-sm hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
                  {cat}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Tags -->
        <div>
          <h3 class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-3">标签</h3>
          <div class="flex flex-wrap gap-2">
            {allTags.map((tag) => (
              <a href={`/blog/tag/${tag}`} class="px-3 py-1 bg-gray-100 dark:bg-gray-800 text-sm rounded-full hover:bg-primary-100 hover:text-primary-700 dark:hover:bg-primary-900/50 dark:hover:text-primary-300 transition-colors">
                {tag}
              </a>
            ))}
          </div>
        </div>
      </aside>

      <!-- Post List -->
      <main class="flex-1">
        <div class="space-y-4">
          {posts.map((post) => (
            <article class="flex gap-6 p-6 bg-white dark:bg-gray-800 rounded-xl hover:shadow-lg transition-shadow">
              <div class="w-32 h-32 bg-gradient-to-br from-primary-100 to-primary-200 dark:from-primary-900/30 dark:to-primary-800/30 rounded-lg flex-shrink-0 hidden sm:block"></div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-3 mb-2">
                  <span class="text-xs px-2 py-1 bg-primary-100 text-primary-700 dark:bg-primary-900/50 dark:text-primary-300 rounded">{post.data.category}</span>
                  <span class="text-xs text-gray-500">{post.data.date.toISOString().split('T')[0]}</span>
                </div>
                <h2 class="text-xl font-semibold mb-2 hover:text-primary-600 transition-colors">
                  <a href={`/blog/${post.slug}`}>{post.data.title}</a>
                </h2>
                <p class="text-gray-600 dark:text-gray-400 text-sm mb-3 line-clamp-2">
                  {post.data.description}
                </p>
                <div class="flex flex-wrap gap-2">
                  {post.data.tags.map((tag) => (
                    <a href={`/blog/tag/${tag}`} class="text-xs px-2 py-1 bg-gray-100 dark:bg-gray-700 rounded-full hover:bg-primary-100 hover:text-primary-700 transition-colors">
                      {tag}
                    </a>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>

        {posts.length === 0 && (
          <div class="text-center py-12 text-gray-500">
            <p>暂无文章</p>
          </div>
        )}
      </main>
    </div>
  </div>
</BaseLayout>
