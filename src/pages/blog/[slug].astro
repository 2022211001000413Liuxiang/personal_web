---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
---

<BaseLayout title={`${post.data.title} | 技术博客`}>
  <article class="max-w-4xl mx-auto px-4 py-12">
    <!-- Header -->
    <header class="mb-12 text-center">
      <div class="flex items-center justify-center gap-4 mb-4">
        <span class="text-sm px-3 py-1 bg-primary-100 text-primary-700 dark:bg-primary-900/50 dark:text-primary-300 rounded-full">{post.data.category}</span>
        <span class="text-sm text-gray-500">{post.data.date.toISOString().split('T')[0]}</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-bold mb-6">{post.data.title}</h1>
      <div class="flex justify-center gap-2">
        {post.data.tags.map((tag) => (
          <span class="text-sm px-3 py-1 bg-gray-100 dark:bg-gray-800 rounded-full">{tag}</span>
        ))}
      </div>
    </header>

    <!-- Content -->
    <div class="prose dark:prose-invert max-w-none">
      <slot />
    </div>

    <!-- Navigation -->
    <nav class="flex justify-between mt-16 pt-8 border-t border-gray-200 dark:border-gray-700">
      <a href="/blog" class="text-primary-600 hover:text-primary-700">
        ← 返回文章列表
      </a>
    </nav>

    <!-- Comments Placeholder -->
    <section class="mt-12 pt-8 border-t border-gray-200 dark:border-gray-700">
      <h3 class="text-lg font-semibold mb-4">评论</h3>
      <div class="p-6 bg-gray-50 dark:bg-gray-800/50 rounded-lg text-center text-gray-500">
        <p>评论功能开发中...</p>
      </div>
    </section>
  </article>
</BaseLayout>
