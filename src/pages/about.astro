---
import BaseLayout from '../layouts/BaseLayout.astro';

const socialLinks = [
  { name: 'GitHub', url: 'https://github.com', icon: 'github' },
  { name: '掘金', url: 'https://juejin.cn', icon: 'juejin' },
  { name: '邮箱', url: 'mailto:example@email.com', icon: 'email' },
];
---

<BaseLayout title="关于 | 技术博客">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="text-center mb-12">
      <div class="w-32 h-32 mx-auto rounded-full bg-gradient-to-br from-primary-400 to-primary-600 flex items-center justify-center text-white text-4xl font-bold mb-6">
        博主
      </div>
      <h1 class="text-3xl font-bold mb-2">关于我</h1>
      <p class="text-gray-600 dark:text-gray-400">一名热爱技术的前端开发者</p>
    </div>

    <div class="grid md:grid-cols-3 gap-8 mb-12">
      <!-- Info Card -->
      <div class="md:col-span-2 bg-white dark:bg-gray-800 rounded-xl shadow-sm p-8">
        <h2 class="text-xl font-semibold mb-4">个人简介</h2>
        <div class="space-y-4 text-gray-600 dark:text-gray-400">
          <p>
            你好！我是一名来自中国的前端开发者，专注于现代 Web 技术的学习与实践。
          </p>
          <p>
            我对前端框架、性能优化、用户体验设计等方面充满兴趣。在工作之余，我喜欢折腾各种新技术，
            并将学习心得整理成博客文章，希望能够帮助到有同样兴趣的开发者朋友们。
          </p>
          <p>
            如果你有任何问题或建议，欢迎通过以下方式与我联系。
          </p>
        </div>
      </div>

      <!-- Contact Card -->
      <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm p-8">
        <h2 class="text-xl font-semibold mb-4">联系方式</h2>
        <div class="space-y-4">
          {socialLinks.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3 text-gray-600 dark:text-gray-400 hover:text-primary-600 transition-colors"
            >
              {link.icon === 'github' && (
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                </svg>
              )}
              {link.icon === 'juejin' && (
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                </svg>
              )}
              {link.icon === 'email' && (
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              )}
              <span>{link.name}</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Site Info -->
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm p-8">
      <h2 class="text-xl font-semibold mb-4">关于本站</h2>
      <div class="space-y-4 text-gray-600 dark:text-gray-400">
        <p>
          这个博客网站使用 <strong>Astro</strong> 框架构建，采用 <strong>Tailwind CSS</strong> 进行样式开发，
          支持 Markdown/MDX 内容创作和响应式布局。
        </p>
        <p>
          网站的主要特点包括：
        </p>
        <ul class="list-disc list-inside space-y-2">
          <li>基于 Markdown 的内容创作</li>
          <li>响应式设计，适配各种设备</li>
          <li>支持浅色/深色主题切换</li>
          <li>SEO 友好设计</li>
          <li>评论系统集成（Giscus）</li>
        </ul>
        <p>
          如果你对网站有任何建议或发现了问题，欢迎提出！
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
