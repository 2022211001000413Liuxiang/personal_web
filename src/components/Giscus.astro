<div class="giscus" id="comments"></div>

<script is:inline>
  const giscusTheme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';

  const script = document.createElement('script');
  script.src = 'https://giscus.app/client.js';
  script.setAttribute('data-repo', '2022211001000413Liuxiang/personal_web');
  script.setAttribute('data-repo-id', 'R_kgDOSRcS4A');
  script.setAttribute('data-category', 'Announcements');
  script.setAttribute('data-category-id', 'DIC_kwDOSRcS4M4C8Gwq');
  script.setAttribute('data-mapping', 'pathname');
  script.setAttribute('data-strict', '0');
  script.setAttribute('data-reactions-enabled', '1');
  script.setAttribute('data-emit-metadata', '0');
  script.setAttribute('data-input-position', 'bottom');
  script.setAttribute('data-theme', giscusTheme);
  script.setAttribute('data-lang', 'zh-CN');
  script.setAttribute('crossorigin', 'anonymous');
  script.async = true;

  document.getElementById('comments')?.appendChild(script);

  // 监听主题变化
  const observer = new MutationObserver(() => {
    const newTheme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
    const iframe = document.querySelector('.giscus-frame');
    if (iframe && iframe.contentWindow) {
      iframe.contentWindow.postMessage(
        { giscus: { setConfig: { theme: newTheme } } },
        'https://giscus.app'
      );
    }
  });

  observer.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['class'],
  });
</script>
